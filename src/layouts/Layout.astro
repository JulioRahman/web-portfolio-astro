---
import "@fontsource-variable/inter";
import "@fontsource-variable/montagu-slab";
import "../styles/global.css";
import { getLocale } from "../paraglide/runtime";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import SeoHead from "../components/SeoHead.astro";

type JsonLd = Record<string, unknown> | Record<string, unknown>[];

interface Props {
  title: string;
  description: string;
  robots?: string;
  seoImage?: ImageMetadata;
  seoImageAlt?: string;
  structuredData?: JsonLd;
}

const { title, description, robots, seoImage, seoImageAlt, structuredData } =
  Astro.props;
---

<!doctype html>
<html lang={getLocale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SeoHead
      title={title}
      description={description}
      robots={robots}
      image={seoImage}
      imageAlt={seoImageAlt}
      structuredData={structuredData}
    />

    <ClientRouter />
  </head>
  <body class="bg-white text-zinc-900 dark:bg-zinc-800 dark:text-zinc-200">
    <Navbar />
    <slot />
    <script is:inline data-astro-rerun>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
        localStorage.theme = "dark";
      } else {
        document.documentElement.classList.remove("dark");
        localStorage.theme = "light";
      }
    </script>
    <script>
      import Hotjar from "@hotjar/browser";
      import { Rive } from "@rive-app/canvas-lite";

      const siteId = 5025471;
      const hotjarVersion = 6;

      Hotjar.init(siteId, hotjarVersion);

      document.addEventListener("astro:page-load", () => {
        const r = new Rive({
          src: "../../scroll_down.riv",
          canvas: document.getElementById(
            "scroll-down-canvas",
          ) as HTMLCanvasElement,
          autoplay: true,
          onLoad: () => {
            r.resizeDrawingSurfaceToCanvas();
          },
        });
      });
    </script>
  </body>
</html>
