---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/montagu-slab/wght.css";
import "../styles/global.css";
import interLatinFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import montaguSlabLatinFont from "@fontsource-variable/montagu-slab/files/montagu-slab-latin-wght-normal.woff2?url";
import { getLocale } from "../paraglide/runtime";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import SeoHead from "../components/SeoHead.astro";
import ContactLinks from "../components/ContactLinks.astro";
import * as m from "../paraglide/messages.js";

type JsonLd = Record<string, unknown> | Record<string, unknown>[];

interface Props {
  title: string;
  description: string;
  robots?: string;
  seoImage?: ImageMetadata;
  seoImageAlt?: string;
  structuredData?: JsonLd;
}

const { title, description, robots, seoImage, seoImageAlt, structuredData } =
  Astro.props;
---

<!doctype html>
<html lang={getLocale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={interLatinFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={montaguSlabLatinFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />

    <SeoHead
      title={title}
      description={description}
      robots={robots}
      image={seoImage}
      imageAlt={seoImageAlt}
      structuredData={structuredData}
    />

    <script is:inline>
      (() => {
        const applyTheme = (root = document.documentElement) => {
          const isDark =
            localStorage.theme === "dark" ||
            (!("theme" in localStorage) &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          root.classList.toggle("dark", isDark);
          localStorage.theme = isDark ? "dark" : "light";
        };

        applyTheme();

        if (window.__themeSwapListenerBound) return;
        window.__themeSwapListenerBound = true;
        document.addEventListener("astro:before-swap", (event) =>
          applyTheme(event.newDocument.documentElement),
        );
      })();
    </script>
    <ClientRouter />
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="4aeb3003-1f3c-48d5-b751-b508f425fec6"
    ></script>
  </head>
  <body class="bg-white text-zinc-900 dark:bg-zinc-800 dark:text-zinc-200">
    <Navbar />
    <slot />
    <footer class="mx-4 max-w-screen-lg py-16 text-center lg:mx-auto">
      <h2 class="mb-4 font-serif text-3xl font-light">
        {m.contact_heading()}
      </h2>
      <ContactLinks />
    </footer>
  </body>
</html>
