---
import Layout from "../../layouts/Layout.astro";
import TopTitle from "../../components/TopTitle.astro";
import Project from "../../components/Project.astro";

import * as m from "../../paraglide/messages.js";


import panintiImage1 from "../../assets/project-paninti-1.png";
import panintiImage2 from "../../assets/project-paninti-2.png";
import parentingHubImage1 from "../../assets/project-parenting-hub-1.png";
import parentingHubImage2 from "../../assets/project-parenting-hub-2.png";
import kocequImage2 from "../../assets/project-kocequ-2.png";
---

<Layout title={m.seo_projects_title()} description={m.seo_projects_description()}>
  <main class="p-4 md:p-10">
    <TopTitle
      titleRawHTMLString={m.projects_top_title()}
      description={m.projects_top_title_desc()}
    />
    <div class="mx-auto grid max-w-4xl gap-12">
      <Project
        priorityImage
        name="Paninti App"
        description="Paninti is an online shopping platform that provides the necessities to make your life easier. Paninti offers a variety of products for the needs of mothers and children, as well as lifestyle."
        techStack={"Kotlin, Android Jetpack, MVVM, Firebase, Google Maps, Git, Material Design 2".split(
          ", ",
        )}
        images={[
          { src: panintiImage1, alt: "Tampilan daftar produk Paninti App" },
          { src: panintiImage2, alt: "Tampilan alur belanja Paninti App" },
        ]}
      />
      <Project
        name="Parenting Hub"
        description="Sosmed"
        techStack={"Kotlin, Android Jetpack, MVVM, Firebase, Git, Material Design 2".split(
          ", ",
        )}
        images={[
          { src: parentingHubImage1, alt: "Tampilan feed artikel Parenting Hub" },
          { src: parentingHubImage2, alt: "Tampilan komunitas Parenting Hub" },
        ]}
      />
      <Project
        name="Kocequ"
        description="Kocequ adalah aplikasi transaksi digital untuk anggota koperasi dan komunitas UMKM. Sebagai Android Developer di Praweda Ciptakarsa Informatika (Soedarpo Informatika) pada Januari–Agustus 2022, saya mengembangkan aplikasi yang sudah beroperasi: mengimplementasikan redesign homepage, katalog produk merchant, serta alur registrasi baru. Seluruh fitur tersebut telah dirilis sebelum masa kerja saya berakhir."
        descriptionExpandedRawHTMLString=`<p>Januari–Agustus 2022 · Kontribusi utama:</p><ul><li>Melanjutkan codebase Java dan menulis fitur baru menggunakan Kotlin dengan tetap mempertahankan arsitektur MVP.</li><li>Membantu pengembangan API pendukung registrasi menggunakan Java Spring Boot.</li><li>Mengimplementasikan katalog merchant untuk menampilkan produk, tanpa checkout.</li><li>Menangani bug tampilan dan crash, termasuk masalah kompatibilitas pada Android KitKat.</li><li>Bekerja bersama developer backend dan tim pengujian; desain UI/UX dan publikasi ke Play Store ditangani oleh rekan lain.</li></ul>`
        techStack={"Java, Kotlin, XML, MVP, Spring Boot".split(
          ", ",
        )}
        images={[{ src: kocequImage2, alt: "Tampilan aplikasi fintech Kocequ" }]}
      />
    </div>
  </main>
</Layout>
