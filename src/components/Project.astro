---
import Carousel from "./Carousel.astro";

interface ProjectImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  name: string;
  description: string;
  descriptionExpandedRawHTMLString?: string;
  techStack: string[];
  images: ProjectImage[];
  priorityImage?: boolean;
}

const {
  name,
  description,
  descriptionExpandedRawHTMLString,
  techStack,
  images,
  priorityImage = false,
} = Astro.props;
---

<div
  class="group rounded-img border border-zinc-950/20 dark:border-white/20"
>
  <Carousel images={images} priorityFirstImage={priorityImage} />
  <div class="space-y-4 p-6">
    <div>
      <div class="flex flex-row justify-between">
        <h2
          class="font-serif text-4xl font-normal text-zinc-900 dark:text-zinc-50"
        >
          {name}
        </h2>
        <div class="embla__dots"></div>
      </div>
      <p class="pt-3 text-lg">{description}</p>
      <div
        class="grid grid-rows-[1fr] opacity-100 transition-all duration-300 ease-out motion-reduce:transition-none pointer-fine:grid-rows-[0fr] pointer-fine:opacity-0 pointer-fine:group-hover:grid-rows-[1fr] pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:grid-rows-[1fr] pointer-fine:group-focus-within:opacity-100"
      >
        <div class="description-expanded overflow-hidden">
          <Fragment set:html={descriptionExpandedRawHTMLString} />
        </div>
      </div>
    </div>
    <div>
      <ul class="mt-2 flex flex-wrap gap-2">
        {
          techStack.map((item) => (
            <li class="rounded-full border border-zinc-950/30 px-3 py-1 text-sm dark:border-white/30">
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style is:global>
  @reference "../styles/global.css";

  @layer theme, base, components, utilities;

  @layer components {
    .embla__dots {
      @apply flex flex-wrap items-center justify-end gap-2;
    }

    .embla__dot {
      @apply m-0 inline-flex size-4 cursor-pointer touch-manipulation appearance-none items-center justify-center rounded-full border border-zinc-500 bg-transparent p-0 dark:border-white/30;
    }

    .embla__dot:after {
      @apply flex size-3 items-center rounded-full content-[''];
    }

    .embla__dot--selected:after {
      @apply bg-zinc-500 dark:bg-white/50;
    }

    .description-expanded {
      p {
        @apply pt-3 text-lg;
      }

      ul {
        @apply list-disc space-y-2 pl-6 pt-2 text-lg;
      }
    }
  }
</style>

<script>
  import EmblaCarousel, {
    type EmblaCarouselType,
    type EmblaOptionsType,
  } from "embla-carousel";
  import Autoplay, { type AutoplayOptionsType } from "embla-carousel-autoplay";
  import { projects_carousel_slide } from "../paraglide/messages.js";

  document.addEventListener("astro:page-load", () => {
    const emblaNodes = [].slice.call(document.querySelectorAll(".embla"));
    const dotsNodes = [].slice.call(document.querySelectorAll(".embla__dots"));
    const emblaOptions: EmblaOptionsType = { loop: true };
    const autoplayOptions: AutoplayOptionsType = { delay: 5000 };

    const emblaCarousels = emblaNodes.map(function (emblaNode) {
      return EmblaCarousel(emblaNode, emblaOptions, [
        Autoplay(autoplayOptions),
      ]);
    });

    const addDotBtnsAndClickHandlers = (
      emblaApi: EmblaCarouselType,
      dotsNode: HTMLElement,
    ): (() => void) => {
      let dotNodes: HTMLElement[] = [];

      const addDotBtnsWithClickHandlers = (): void => {
        dotNodes = emblaApi.scrollSnapList().map((_, index, slides) => {
          const button = document.createElement("button");
          button.className = "embla__dot";
          button.type = "button";
          button.setAttribute(
            "aria-label",
            projects_carousel_slide({ slide: index + 1, total: slides.length }),
          );
          button.addEventListener("click", () => emblaApi.scrollTo(index));
          return button;
        });
        dotsNode.replaceChildren(...dotNodes);
      };

      const toggleDotBtnsActive = (): void => {
        const previous = emblaApi.previousScrollSnap();
        const selected = emblaApi.selectedScrollSnap();
        dotNodes[previous].classList.remove("embla__dot--selected");
        dotNodes[previous].removeAttribute("aria-current");
        dotNodes[selected].classList.add("embla__dot--selected");
        dotNodes[selected].setAttribute("aria-current", "true");
      };

      emblaApi
        .on("init", addDotBtnsWithClickHandlers)
        .on("reInit", addDotBtnsWithClickHandlers)
        .on("init", toggleDotBtnsActive)
        .on("reInit", toggleDotBtnsActive)
        .on("select", toggleDotBtnsActive);

      return (): void => {
        dotsNode.innerHTML = "";
      };
    };

    dotsNodes.forEach((node, i) => {
      if (emblaCarousels[i].scrollSnapList().length > 1) {
        const removeDotBtnsAndClickHandlers = addDotBtnsAndClickHandlers(
          emblaCarousels[i],
          node,
        );
        emblaCarousels[i].on("destroy", removeDotBtnsAndClickHandlers);
      }
    });
  });
</script>
