---
import * as m from "../paraglide/messages.js";
---

<div
  class="mb-32 mt-6 flex flex-row place-items-center justify-center text-xs uppercase"
>
  <svg
    data-scroll-down-icon
    class="size-6"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <rect
      x="6"
      y="2.5"
      width="12"
      height="19"
      rx="6"
      fill="none"
      stroke="currentColor"
      stroke-width="0.75"></rect>
    <circle cx="12" cy="8" r="2" fill="currentColor"></circle>
  </svg>
  {m.scroll_down()}
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    circle {
      animation: scroll-wheel 1.6s ease-in-out infinite;
    }
  }

  @keyframes scroll-wheel {
    55%,
    100% {
      opacity: 0;
      transform: translateY(7px);
    }
  }
</style>
