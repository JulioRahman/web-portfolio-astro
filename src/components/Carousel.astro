---
import { Picture } from "astro:assets";

interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
}

const { images } = Astro.props;
---

<div
  class="embla aspect-[3/2] rounded-t-img cursor-grab overflow-hidden active:cursor-grabbing"
>
  <div class="flex">
    {
      images.map(({ src, alt }) => (
        <div class="min-w-0 shrink-0 grow-0 basis-full">
          <Picture src={src} class="w-full" loading="eager" alt={alt} />
        </div>
      ))
    }
  </div>
</div>
