---
import { Picture } from "astro:assets";

interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  priorityFirstImage?: boolean;
}

const { images, priorityFirstImage = false } = Astro.props;

const imageWidths = [320, 480, 640, 768, 896, 1080, 1344, 1788];
const imageSizes =
  "(min-width: 976px) 896px, (min-width: 768px) calc(100vw - 5rem), calc(100vw - 2rem)";
---

<div
  class="embla aspect-[3/2] rounded-t-img cursor-grab overflow-hidden active:cursor-grabbing"
>
  <div class="flex">
    {
      images.map(({ src, alt }, index) => {
        const isPriorityImage = priorityFirstImage && index === 0;

        return (
          <div class="min-w-0 shrink-0 grow-0 basis-full">
            <Picture
              src={src}
              class="w-full"
              widths={imageWidths}
              sizes={imageSizes}
              loading={isPriorityImage ? "eager" : "lazy"}
              fetchpriority={isPriorityImage ? "high" : undefined}
              alt={alt}
            />
          </div>
        );
      })
    }
  </div>
</div>
